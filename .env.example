# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAABBBCCC-your_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://grammerce:grammerce@db:5432/grammerce_bot

# Telegram chat ID for operator support forwarding
SUPPORT_CHAT_ID=-1001234567890

# Grammerce platform integration (Telegram Auth)
# PLATFORM_URL — base URL of the platform (no trailing slash)
# PLATFORM_BOT_SHARED_SECRET — must exactly match BOT_SHARED_SECRET on the platform side
PLATFORM_URL=https://grammerce.io
PLATFORM_BOT_SHARED_SECRET=change-me-must-match-platform

# Inbound webhook server — platform calls this to notify the bot of new
# registrations (POST /api/bot/user-registered with X-Bot-Secret header).
# The platform must be able to reach BOT_WEBHOOK_PORT on this host.
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8080

# Demo bot links (t.me/username format — open the demo bot in Telegram)
DEMO_BOT_COFFEE=https://t.me/grammerce_coffee_bot
DEMO_BOT_CLOTHES=https://t.me/grammerce_clothes_bot
DEMO_BOT_FLOWERS=https://t.me/grammerce_flowers_bot
DEMO_BOT_FOOD=https://t.me/grammerce_food_bot
DEMO_BOT_COSMETICS=https://t.me/grammerce_cosmetics_bot
DEMO_BOT_ELECTRONICS=https://t.me/grammerce_electronics_bot
